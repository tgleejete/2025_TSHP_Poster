 True\n","docs = None\n","chunks = None\n","retriever = None\n","all_examples = []\n","filtered_examples = []\n","SEED = 42\n","random.seed(SEED)\n","\n","# GPU 設定\n","device = 'cuda' if torch.cuda.is_available() else 'cpu'\n","print(f\"使用設備: {device}\")\n","\n","# 嵌入模型設定\n","EMBEDDING_MODEL = \"BAAI/bge-large-zh-v1.5\"\n","try:\n","    bge_embeddings = HuggingFaceBgeEmbeddings(\n","        model_name=EMBEDDING_MODEL,\n","        model_kwargs={'device': device},\n","        encode_kwargs={'normalize_embeddings': True},\n","        query_instruction=\"為這個句子產生表示以用於檢索相關文件：\"\n","    )\n","    print(\"✅ 嵌入模型載入成功\")\n","except Exception as e:\n","    print(f\"❌ 嵌入模型載入失敗: {e}\")\n","\n","# API 設定\n","# Changed to use Google Gemini API\n","MODEL_NAME = \"gemini-2.5-flash\"  # 可替換為 gemini-pro 等其他模型\n","GOOGLE_API_KEY = userdata.get(\"GOOGLE_API_KEY\")\n","\n","# 設定 API 金鑰\n","try:\n","    genai.configure(api_key=GOOGLE_API_KEY)\n","    model = genai.GenerativeModel(model_name=MODEL_NAME)\n","    print(\"✅ API 客戶端設定成功\")\n","except Exception as e:\n","    print(f\"❌ API 設定失敗: {e}\")\n","SYSTEM_PROMPT = \"\"\"你是一位專業的內容分析師與問答產生專家。\n","你的任務是根據提供的文件片段，產生高品質、有深度、且完全基於文本的問答對。\n","\n","# 規則：\n","1.  **忠於原文**：所有問題的答案都必須能直接從提供的「文件片段」中找到，不得添加任何外部知識或個人推斷。\n","2.  **問題多樣性**：產生不同類型的問題，例如「是什麼」、「為什麼」、「如何」、「比較差異」等。避免簡單的是非題。\n","3.  **答案精確**：答案需簡潔且直接回應問題，並使用與原文相同的繁體中文。\n","4.  **格式嚴謹**：嚴格遵循指定的 JSON 輸出格式，不要在 JSON 陣列前後添加任何額外文字。\n","\"\"\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bU-7MxsnoHTk","executionInfo":{"status":"ok","timestamp":1755702052865,"user_tz":-480,"elapsed":7315,"user":{"displayName":"TMU大數據李易昌","userId":"17939461066213020848"}},"outputId":"1a240503-959d-4de3-8a5c-fbe3056cfc2d"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["使用設備: cpu\n","✅ 嵌入模型載入成功\n"]}]},{"cell_type":"code","source":["# 改進版本的 QA 資料集生成程式\n","import os, re, json, uuid, random, time\n","from dataclasses import asdict, dataclass, field\n","from typing import List, Dict, Any\n","import tiktoken, pandas as pd\n","from langchain_community.document_loaders import TextLoader, PyPDFLoader, UnstructuredWordDocumentLoader, CSVLoader\n","from langchain.text_splitter import RecursiveCharacterTextSplitter\n","from langchain_community.embeddings import HuggingFaceBgeEmbeddings\n","from langchain.vectorstores import FAISS\n","from openai import OpenAI\n","import torch\n","from google.colab import userdata\n","from tqdm import tqdm  # 添加進度條\n","\n","# 配置和設定\n","FOLDER_PATH = \"downloaded_pdfs\"\n","OUTPUT_JSONL = \"qa_dataset.jsonl\"\n","OUTPUT_CSV = \"qa_dataset.csv\"\n","BUILD_FAISS = True\n","SEED = 42\n","random.seed(SEED)\n","\n","# GPU 設定\n","device = 'cuda' if torch.cuda.is_available() else 'cpu'\n","print(f\"使用設備: {device}\")\n","\n","# 嵌入模型設定\n","EMBEDDING_MODEL = \"BAAI/bge-large-zh-v1.5\"\n","try:\n","    bge_embeddings = HuggingFaceBgeEmbeddings(\n","        model_name=EMBEDDING_MODEL,\n","        model_kwargs={'device': device},\n","        encode_kwargs={'normalize_embeddings': True},\n","        query_instruction=\"為這個句子產生表示以用於檢索相關文件：\"\n","    )\n","    print(\"✅ 嵌入模型載入成功\")\n","except Exception as e:\n","    print(f\"❌ 嵌入模型載入失敗: {e}\")\n","\n","# API 設定\n","MODEL_NAME = os.environ.get(\"GROQ_MODEL\", \"llama3-70b-8192\")\n","BASE_URL = os.environ.get(\"GROQ_BASE_URL\", \"https://api.groq.com/openai/v1\")\n","try:\n","    GROQ_API_KEY = userdata.get(\"Groq\")\n","    client = OpenAI(base_url=BASE_URL, api_key=GROQ_API_KEY)\n","    print(\"✅ API 客戶端設定成功\")\n","except Exception as e:\n","    print(f\"❌ API 設定失敗: {e}\")\n","\n","SYSTEM_PROMPT = \"你是資深的知識工程師。請以文件內容為唯一依據，產生高品質中文 QA。\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mY_SD3CKAOGe","executionInfo":{"status":"ok","timestamp":1755702232853,"user_tz":-480,"elapsed":5806,"user":{"displayName":"TMU大數據李易昌","userId":"17939461066213020848"}},"outputId":"e48f9179-e726-45d3-a5a7-997dc26d15b6"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["使用設備: cpu\n","✅ 嵌入模型載入成功\n","✅ API 客戶端設定成功\n"]}]},{"cell_type":"code","source":["# 改進的文檔載入功能\n","def load_documents(folder_path: str):\n","    documents = []\n","    if not os.path.isdir(folder_path):\n","        print(f\"⚠️ 找不到資料夾：{folder_path}\")\n","        return documents\n","\n","    files = [f for f in os.listdir(folder_path) if f.endswith(('.txt', '.pdf', '.docx', '.csv'))]\n","    print(f\"發現 {len(files)} 個文件\")\n","\n","    for file in tqdm(files, desc=\"載入文件\"):\n","        path = os.path.join(folder_path, file)\n","        try:\n","            if file.endswith(\".txt\"):\n","                loader = TextLoader(path)\n","            elif file.endswith(\".pdf\"):\n","                loader = PyPDFLoader(path)\n","            elif file.endswith(\".docx\"):\n","                loader = UnstructuredWordDocumentLoader(path)\n","            elif file.endswith(\".csv\"):\n","                loader = CSVLoader(path)\n","            else:\n","                continue\n","\n","            docs = loader.load()\n","            documents.extend(docs)\n","            print(f\"✅ {file}: {len(docs)} 頁\")\n","\n","        except Exception as e:\n","            print(f\"❌ 載入失敗：{file} -> {e}\")\n","            continue\n","\n","    print(f\"總共載入 {len(documents)} 個文檔片段\")\n","    return documents\n","\n","# 改進的文檔切分\n","tokenizer = tiktoken.get_encoding(\"cl100k_base\")\n","\n","def count_tokens(text):\n","    return len(tokenizer.encode(text))\n","\n","# 調整切塊參數以減少處理量\n","splitter = RecursiveCharacterTextSplitter(\n","    chunk_size=800,  # 增加切塊大小\n","    chunk_overlap=150,  # 增加重疊\n","    separators=[\"\\\\n\\\\n\", \"\\\\n\", \"。\", \"？\", \"！\", \"，\", \"；\", \"：\", \" \", \"\"],\n","    length_function=count_tokens,\n","    add_start_index=True\n",")\n","\n","def split_docs(documents):\n","    chunks = splitter.split_documents(documents)\n","    print(f\"文檔切分為 {len(chunks)} 個片段\")\n","    return chunks\n","\n","def build_faiss(chunks):\n","    print(\"正在建立 FAISS 索引...\")\n","    try:\n","        db = FAISS.from_documents(chunks, bge_embeddings)\n","        print(\"✅ FAISS 索引建立成功\")\n","        return db.as_retriever(search_kwargs={\"k\": 4})\n","    except Exception as e:\n","        print(f\"❌ FAISS 建立失敗: {e}\")\n","        return None\n","\n","@dataclass\n","class QAExample:\n","    id: str\n","    question: str\n","    answer: str\n","    contexts: List[str] = field(default_factory=list)\n","    ground_truths: List[str] = field(default_factory=list)\n","    meta: Dict[str, Any] = field(default_factory=dict)\n","\n","EXAMPLE_QA = \"\"\"[\n","    {\n","        \"question\": \"太陽能板是利用什麼原理發電的？\",\n","        \"answer\": \"太陽能板透過光電效應將陽光轉換為直流電。\",\n","        \"evidence\": \"太陽能板透過光電效應將陽光轉換為直流電。\"\n","    },\n","    {\n","        \"question\": \"太陽能發電有哪些優點和缺點？\",\n","        \"answer\": \"太陽能發電的優點是它在發電過程中不產生溫室氣體，是一種潔淨能源。其缺點是發電效率會受天氣影響，且製造過程耗能。\",\n","        \"evidence\": \"此過程不產生任何溫室氣體，是一種潔淨能源。然而，其發電效率會受到天氣影響，且製造過程需要消耗大量能源。\"\n","    }\n","]\"\"\"\n","\n","# 結合 CoT 和 Few-Shot 的提示模板\n","QA_GEN_PROMPT_TEMPLATE = \"\"\"請嚴格按照以下步驟執行，並**只回傳純 JSON 陣列，不要有任何說明文字**，格式與範例如下：\n","\n","第一步：仔細閱讀並理解「文件片段」的核心內容。\n","第二步：根據內容產生 2-3 個高品質的問答（QA）配對。\n","第三步：每個 QA 配對須包含 question, answer, evidence 三個欄位，並且從文件片段中擷取答案與證據。\n","\n","輸出格式範例（**嚴格只輸出 JSON，不要任何額外文字**）：\n","\n","```json\n","{example_qa}\n","```\n","\n","**文件片段**\n","```text\n","{context}\n","```\n","\n","**你的輸出 (僅含 JSON 陣列):**\"\"\"\n","\n","def call_llm(prompt: str, max_retries: int = 3) -> str:\n","    for attempt in range(max_retries):\n","        try:\n","            resp = client.chat.completions.create(\n","                model=MODEL_NAME,\n","                messages=[\n","                    {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n","                    {\"role\": \"user\", \"content\": prompt},\n","                ],\n","                temperature=0.3,  # 稍微增加創造性\n","                max_tokens=1000,  # 增加最大 token 數\n","                timeout=30  # 增加超時設定\n","            )\n","            return resp.choices[0].message.content\n","        except Exception as e:\n","            print(f\"API 調用失敗 (嘗試 {attempt + 1}/{max_retries}): {e}\")\n","            if attempt < max_retries - 1:\n","                time.sleep(2 ** attempt)  # 指數退避\n","            else:\n","                return \"\"\n","    return \"\"\n","\n","\n","def parse_json_list(text: str):\n","    \"\"\"改進的 JSON 解析\"\"\"\n","    if not text:\n","        return []\n","\n","    cleaned = text.strip()\n","    # 移除可能的 markdown 標記\n","    if cleaned.startswith(\"```json\"):\n","        cleaned = cleaned[7:]\n","    if cleaned.endswith(\"```\"):\n","        cleaned = cleaned[:-3]\n","    cleaned = cleaned.strip()\n","\n","    # 尋找 JSON 陣列\n","    start, end = cleaned.find(\"[\"), cleaned.rfind(\"]\")\n","    if start == -1 or end == -1:\n","        return []\n","\n","    try:\n","        json_str = cleaned[start:end+1]\n","        return json.loads(json_str)\n","    except json.JSONDecodeError as e:\n","        print(f\"JSON 解析錯誤: {e}\")\n","        print(f\"原始文本: {text[:200]}...\")\n","        return []\n","\n","def generate_qa_from_chunk(chunk):\n","    content = chunk.page_content\n","    if len(content.strip()) < 50:\n","        return []\n","\n","    meta = {\n","        \"source\": chunk.metadata.get(\"source\", \"unknown\"),\n","        \"page\": chunk.metadata.get(\"page\", 0),\n","        \"start_index\": chunk.metadata.get(\"start_index\", 0)\n","    }\n","\n","    # 限制內容長度避免超過token限制\n","    truncated_content = content[:1500]\n","\n","    prompt = f\"\"\"請根據以下文件片段，產生 2-3 個問答配對，格式必須嚴格是 JSON 陣列，且不要包含任何多餘文字或說明。\n","\n","文件片段：\n","\\\"\\\"\\\"\n","{truncated_content}\n","\\\"\\\"\\\"\n","\n","請直接輸出 JSON 陣列，格式如下：\n","[\n","  {{\n","    \"question\": \"你的問題\",\n","    \"answer\": \"問題的答案\",\n","    \"evidence\": \"證據文本\"\n","  }}\n","]\n","\n","你的回答 (僅含 JSON 陣列):\"\"\"\n","\n","    raw_response = call_llm(prompt)\n","\n","    if not raw_response:\n","        return []\n","\n","    items = parse_json_list(raw_response)\n","    out = []\n","\n","    for it in items:\n","        question = it.get(\"question\", \"\").strip()\n","        answer = it.get(\"answer\", \"\").strip()\n","        evidence = it.get(\"evidence\", answer).strip()\n","\n","        if not question or not answer or len(question) < 5 or len(answer) < 10:\n","            continue\n","\n","        out.append(QAExample(\n","            id=str(uuid.uuid4()),\n","            question=question,\n","            answer=answer,\n","            contexts=[content],\n","            ground_truths=[evidence],\n","            meta=meta\n","        ))\n","\n","    return out\n","\n","def dedup_and_filter(examples: List[QAExample]):\n","    \"\"\"改進的去重和過濾\"\"\"\n","    seen_questions = set()\n","    seen_answers = set()\n","    out = []\n","\n","    for ex in examples:\n","        # 標準化問題和答案用於比較\n","        q_key = re.sub(r'[，。！？\\s]+', '', ex.question.lower())\n","        a_key = re.sub(r'[，。！？\\s]+', '', ex.answer.lower())\n","\n","        # 檢查重複\n","        if q_key in seen_questions or a_key in seen_answers:\n","            continue\n","\n","        # 品質過濾\n","        if len(ex.question) < 5 or len(ex.answer) < 10:\n","            continue\n","\n","        seen_questions.add(q_key)\n","        seen_answers.add(a_key)\n","        out.append(ex)\n","\n","    return out\n","\n","def save_results(examples: List[QAExample]):\n","    \"\"\"保存結果\"\"\"\n","    os.makedirs(\"outputs\", exist_ok=True)\n","\n","    # 保存 JSONL\n","    with open(f\"outputs/{OUTPUT_JSONL}\", \"w\", encoding=\"utf-8\") as f:\n","        for ex in examples:\n","            f.write(json.dumps(asdict(ex), ensure_ascii=False) + \"\\n\")\n","\n","    # 保存 CSV\n","    df_data = []\n","    for ex in examples:\n","        df_data.append({\n","            'id': ex.id,\n","            'question': ex.question,\n","            'answer': ex.answer,\n","            'contexts': '; '.join(ex.contexts),\n","            'ground_truths': '; '.join(ex.ground_truths),\n","            'source': ex.meta.get('source', ''),\n","            'page': ex.meta.get('page', ''),\n","        })\n","\n","    pd.DataFrame(df_data).to_csv(f\"outputs/{OUTPUT_CSV}\", index=False, encoding=\"utf-8-sig\")\n","    print(f\"✅ 已輸出 {len(examples)} 個 QA 到 outputs/\")\n","\n","# 主執行函數\n","def main():\n","    \"\"\"主執行函數，包含錯誤處理和進度顯示\"\"\"\n","    try:\n","        print(\"🚀 開始 QA 資料集生成...\")\n","\n","        # 載入文檔\n","        docs = load_documents(FOLDER_PATH)\n","        if not docs:\n","            print(\"❌ 沒有載入任何文檔\")\n","            return\n","\n","        # 切分文檔\n","        chunks = split_docs(docs)\n","        if not chunks:\n","            print(\"❌ 沒有生成任何文檔片段\")\n","            return\n","\n","        # 建立 FAISS 索引（如果需要）\n","        if BUILD_FAISS:\n","            retriever = build_faiss(chunks)\n","\n","        # 生成 QA\n","        print(f\"📝 開始生成 QA，總共 {len(chunks)} 個片段...\")\n","        all_examples = []\n","\n","        # 分批處理以避免記憶體問題\n","        batch_size = 10\n","        for i in tqdm(range(0, len(chunks), batch_size), desc=\"處理批次\"):\n","            batch_chunks = chunks[i:i+batch_size]\n","            batch_examples = []\n","\n","            for chunk in batch_chunks:\n","                try:\n","                    examples = generate_qa_from_chunk(chunk)\n","                    batch_examples.extend(examples)\n","                except Exception as e:\n","                    print(f\"⚠️ 處理片段時出錯: {e}\")\n","                    continue\n","\n","            all_examples.extend(batch_examples)\n","\n","            # 定期報告進度\n","            if (i // batch_size + 1) % 5 == 0:\n","                print(f\"已處理 {min(i + batch_size, len(chunks))}/{len(chunks)} 片段，累積 {len(all_examples)} QA\")\n","\n","        print(f\"📊 生成完成，總共 {len(all_examples)} 個原始 QA\")\n","\n","        # 去重和過濾\n","        filtered_examples = dedup_and_filter(all_examples)\n","        print(f\"🔍 過濾後剩餘 {len(filtered_e